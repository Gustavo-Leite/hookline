APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

POSTGRES_USER=hookline
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379

POSTGRES_DB=hookline
# host is "localhost" when the app runs on your machine, "postgres" inside docker compose
DATABASE_URL=postgres://hookline:change-me@localhost:5432/hookline?sslmode=disable

# goose reads these automatically; keep in sync with DATABASE_URL
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://hookline:change-me@localhost:5432/hookline?sslmode=disable
GOOSE_MIGRATION_DIR=migrations

REDIS_URL=redis://localhost:6379/0

# development only: lets the worker deliver to loopback and private addresses
ALLOW_PRIVATE_DELIVERY_TARGETS=true

RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=60
