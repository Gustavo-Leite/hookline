{
  "info": {
    "name": "hookline",
    "description": "Reliable webhook delivery service. Set the apiKey variable to a key produced by `docker compose run --rm admin create-application <name>`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{apiKey}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "apiKey", "value": "" },
    { "key": "endpointId", "value": "" },
    { "key": "idempotencyKey", "value": "abc-123" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/healthz", "host": ["{{baseUrl}}"], "path": ["healthz"] }
          }
        },
        {
          "name": "Readiness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/readyz", "host": ["{{baseUrl}}"], "path": ["readyz"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/me", "host": ["{{baseUrl}}"], "path": ["v1", "me"] }
          }
        },
        {
          "name": "Who am I (no key) -> 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/me", "host": ["{{baseUrl}}"], "path": ["v1", "me"] }
          }
        }
      ]
    },
    {
      "name": "Endpoints",
      "item": [
        {
          "name": "Create endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('endpointId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/hooks\",\n  \"description\": \"my first endpoint\",\n  \"event_types\": [\"user.created\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/endpoints", "host": ["{{baseUrl}}"], "path": ["v1", "endpoints"] }
          }
        },
        {
          "name": "Create endpoint (plain http) -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"http://example.com/hooks\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/endpoints", "host": ["{{baseUrl}}"], "path": ["v1", "endpoints"] }
          }
        },
        {
          "name": "List endpoints",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/v1/endpoints", "host": ["{{baseUrl}}"], "path": ["v1", "endpoints"] }
          }
        },
        {
          "name": "Get endpoint",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/endpoints/{{endpointId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "endpoints", "{{endpointId}}"]
            }
          }
        },
        {
          "name": "Delete endpoint",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/v1/endpoints/{{endpointId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "endpoints", "{{endpointId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "1. Create event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"user.created\",\n  \"payload\": { \"id\": 42 }\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/events", "host": ["{{baseUrl}}"], "path": ["v1", "events"] }
          }
        },
        {
          "name": "2. Replay (same key, same payload) -> same id",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"user.created\",\n  \"payload\": { \"id\": 42 }\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/events", "host": ["{{baseUrl}}"], "path": ["v1", "events"] }
          }
        },
        {
          "name": "3. Same key, different payload -> 409",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"user.created\",\n  \"payload\": { \"id\": 99 }\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/events", "host": ["{{baseUrl}}"], "path": ["v1", "events"] }
          }
        },
        {
          "name": "4. No idempotency key -> always a new id",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"user.created\",\n  \"payload\": { \"id\": 42 }\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/events", "host": ["{{baseUrl}}"], "path": ["v1", "events"] }
          }
        }
      ]
    }
  ]
}
